{
  "name": "datocms-plugin-geojson-polygons",
  "version": "1.1.2",
  "description": "Draw and edit GeoJSON polygons on a map inside a DatoCMS JSON field.",
  "homepage": "https://github.com/rodrigobarona/datocms-plugin-geojson-polygons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigobarona/datocms-plugin-geojson-polygons.git"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "datocms-plugin",
    "geojson",
    "polygon",
    "map",
    "maplibre"
  ],
  "files": [
    "dist",
    "marketplace",
    "docs/demo.mp4"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.8.1",
  "datoCmsPlugin": {
    "title": "GeoJSON Polygons",
    "entryPoint": "dist/index.html",
    "coverImage": "marketplace/cover.jpg",
    "previewImage": "docs/demo.mp4",
    "permissions": []
  },
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "dev": "node scripts/copy-maplibre-worker.mjs && vite",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build": "node scripts/copy-maplibre-worker.mjs && tsc -b && vite build",
    "check": "pnpm lint && pnpm test && pnpm build",
    "preview": "vite preview",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "datocms-plugin-sdk": "2.5.0",
    "datocms-react-ui": "2.5.1",
    "maplibre-gl": "6.11.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "datocms-react-ui": {
      "react-intersection-observer": "11.0.1",
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
